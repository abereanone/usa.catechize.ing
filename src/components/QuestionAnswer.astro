---
interface Props {
  answerHtml: string;
  hideByDefault: boolean;
}

const { answerHtml, hideByDefault } = Astro.props;

const html = answerHtml || "<p><em>Content not found.</em></p>";
---

{hideByDefault ? (
  <div class="question-answer-toggle" data-answer-toggle>
    <button type="button" class="answer-toggle" data-answer-toggle-button aria-expanded="false">
      See answer
    </button>
    <div class="question-body" data-answer-content hidden set:html={html} />

    <script type="module" is:inline>
      // Kept inline and inside this branch on purpose: a hoisted script tag ships on
      // every page that renders this component, and with hideAnswersByDefault false
      // that would be dead bytes on all ~1000 question pages.
      document.querySelectorAll("[data-answer-toggle]").forEach((section) => {
        const button = section.querySelector("[data-answer-toggle-button]");
        const content = section.querySelector("[data-answer-content]");
        if (!button || !content) {
          return;
        }

        button.addEventListener("click", () => {
          button.setAttribute("aria-expanded", "true");
          content.hidden = false;
          button.hidden = true;
        });
      });
    </script>
  </div>
) : (
  <div class="question-body" set:html={html} />
)}

<style is:global>
  /* is:global preserves the previous unscoped behaviour of these rules. */
  .question-answer-toggle {
    margin-top: 1rem;
  }

  .answer-toggle {
    width: 100%;
    padding: 1.1rem 1.25rem;
    font-size: 1.15rem;
    border-radius: 0.9rem;
    border: 1px solid var(--surface-border);
    background: var(--surface-panel);
    color: var(--color-text);
    cursor: pointer;
    font-weight: 600;
    text-align: left;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .answer-toggle:hover,
  .answer-toggle:focus-visible {
    border-color: var(--surface-border-strong);
    background: var(--surface-highlight);
    outline: none;
    transform: translateY(-1px);
  }

  .question-body[hidden] {
    display: none;
  }
</style>
